file(READ "${GEN}/nv2a_hlsl.inc" embedded)
file(READ "${GEN}/units/y16d.hlsl" depth_unit)
file(READ "${GEN}/units/ub.hlsl" vertex_unit)
get_filename_component(ROOT "${ROOT}" ABSOLUTE)
if(PORT)
    set(depth_source "${PORT}/nv2a_y16d.hlsl")
    string(FIND "${embedded}" "XBR_PORT_SHADER_TEST" marker)
    if(marker LESS 0)
        message(FATAL_ERROR "D3D11 embedding lost the port-owned shader")
    endif()
else()
    set(depth_source "${ROOT}/src/video/shaders/nv2a_y16d.hlsl")
endif()
string(FIND "${depth_unit}" "${depth_source}" depth_path)
string(FIND "${vertex_unit}" "${ROOT}/src/video/shaders/nv2a_vertex.hlsl" fallback)
if(depth_path LESS 0 OR fallback LESS 0)
    message(FATAL_ERROR "SDL shader sources lost selected/fallback fragments")
endif()
if(NOT EXISTS "${GEN}/sdlgpu/y16d_ps.spirv.h")
    message(FATAL_ERROR "Selected depth shader was not compiled to SPIR-V")
endif()
message(STATUS "Selected shared/port fragments embedded and compiled")
