file(READ "${GEN}/nv2a_hlsl.inc" embedded)
file(READ "${GEN}/units/ub.hlsl" vertex_unit)
get_filename_component(ROOT "${ROOT}" ABSOLUTE)
if(DEPTH_SOURCE)
    file(READ "${GEN}/units/y16d.hlsl" depth_unit)
    string(FIND "${depth_unit}" "${DEPTH_SOURCE}" selected)
    if(selected LESS 0 OR NOT EXISTS "${GEN}/sdlgpu/y16d_ps.spirv.h")
        message(FATAL_ERROR "Caller depth converter was not selected/compiled")
    endif()
    if(TEST_PORT)
        string(FIND "${embedded}" "XBR_PORT_SHADER_TEST" marker)
        if(marker LESS 0)
            message(FATAL_ERROR "D3D11 embedding lost the caller converter")
        endif()
    endif()
else()
    string(FIND "${embedded}" "y16d_ps" implicit)
    if(NOT implicit LESS 0)
        message(FATAL_ERROR "Unconfigured build embedded an implicit depth proxy")
    endif()
endif()
string(FIND "${vertex_unit}" "${ROOT}/src/video/shaders/nv2a_vertex.hlsl" fallback)
if(fallback LESS 0)
    message(FATAL_ERROR "SDL vertex source lost the shared fallback")
endif()
message(STATUS "Shared/optional caller fragments selected without an implicit depth proxy")
